<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp">

    <!-- 标题 -->
    <TextView
        android:id="@android:id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/note_word_count"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="一个非常长的笔记标题" />

    <!-- 字数 (与标题水平，在右侧) -->
    <TextView
        android:id="@+id/note_word_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignBaseline="@android:id/text1"
        android:layout_marginStart="8dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="125 字"
        tools:textColor="@android:color/darker_gray" />

    <!-- 修改时间 -->
    <TextView
        android:id="@+id/note_modification_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@android:id/text1"
        android:layout_alignParentStart="true"
        android:layout_marginTop="4dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="2025-12-06 10:30"
        tools:textColor="@android:color/darker_gray" />

    <!-- 文件夹名称 (与时间水平，在右下角) -->
    <TextView
        android:id="@+id/note_folder_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@android:id/text1"
        android:layout_alignParentEnd="true"
        android:layout_alignBaseline="@id/note_modification_date"
        android:layout_marginTop="4dp"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:drawableStartCompat="@drawable/ic_folder_small"
        app:drawableTint="?attr/colorOnSurfaceVariant"
        tools:text="学习资料"
        tools:textColor="@android:color/darker_gray" />
</RelativeLayout>