<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="16dp">

    <ImageView
        android:id="@+id/folder_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_folder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="@string/folder_icon_description"/>

    <!-- 笔记数量徽章 -->
    <TextView
        android:id="@+id/folder_note_count_badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/badge_circle_background"
        android:gravity="center"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="@id/folder_icon"
        app:layout_constraintTop_toTopOf="@id/folder_icon"
        android:layout_marginEnd="-10dp"
        tools:text="99+"
        tools:ignore="SmallSp"/>

    <TextView
        android:id="@+id/folder_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/folder_icon"
        tools:text="My Awesome Folder Name That Is Very Long" />

</androidx.constraintlayout.widget.ConstraintLayout>